{
  "kind": "zbot.ontology",
  "schemaVersion": 1,
  "ontologyId": "zbot.base:v1",
  "label": "Zbot Base Ontology",
  "description": "Base advisory ontology for zbot memory and knowledge graph records. Custom entity and relationship values remain allowed.",
  "validationMode": "advisory",
  "allowUnclassified": "allow",
  "entityClasses": [
    { "id": "person", "label": "Person" },
    { "id": "organization", "label": "Organization", "aliases": ["org", "company"] },
    { "id": "location", "label": "Location", "aliases": ["place"] },
    { "id": "concept", "label": "Concept", "aliases": ["topic"] },
    { "id": "tool", "label": "Tool", "aliases": ["technology"] },
    { "id": "project", "label": "Project" },
    { "id": "file", "label": "File" },
    { "id": "event", "label": "Event" },
    { "id": "time_period", "label": "Time Period", "aliases": ["year", "era"] },
    { "id": "document", "label": "Document", "aliases": ["doc"] },
    { "id": "role", "label": "Role", "aliases": ["title"] },
    { "id": "artifact", "label": "Artifact" },
    { "id": "ward", "label": "Ward" },
    { "id": "custom", "label": "Custom", "open": true }
  ],
  "relationshipProperties": [
    { "id": "works_for", "label": "Works For", "domain": ["person"], "range": ["organization"] },
    { "id": "located_in", "label": "Located In", "range": ["location"] },
    { "id": "related_to", "label": "Related To" },
    { "id": "created", "label": "Created" },
    { "id": "uses", "label": "Uses" },
    { "id": "part_of", "label": "Part Of" },
    { "id": "mentions", "label": "Mentions" },
    { "id": "before", "label": "Before", "domain": ["event", "time_period"], "range": ["event", "time_period"] },
    { "id": "after", "label": "After", "domain": ["event", "time_period"], "range": ["event", "time_period"] },
    { "id": "during", "label": "During", "domain": ["event"], "range": ["event", "time_period"] },
    { "id": "concurrent_with", "label": "Concurrent With", "domain": ["event"], "range": ["event"] },
    { "id": "succeeded_by", "label": "Succeeded By" },
    { "id": "preceded_by", "label": "Preceded By" },
    { "id": "president_of", "label": "President Of", "domain": ["person"], "range": ["organization", "location"] },
    { "id": "founder_of", "label": "Founder Of", "domain": ["person"], "range": ["organization", "project"] },
    { "id": "member_of", "label": "Member Of", "domain": ["person", "organization"], "range": ["organization"] },
    { "id": "author_of", "label": "Author Of", "domain": ["person", "organization"], "range": ["document", "artifact"] },
    { "id": "held_role", "label": "Held Role", "domain": ["person"], "range": ["role"] },
    { "id": "employed_by", "label": "Employed By", "domain": ["person"], "range": ["organization"] },
    { "id": "held_at", "label": "Held At", "domain": ["event"], "range": ["location"] },
    { "id": "born_in", "label": "Born In", "domain": ["person"], "range": ["location"] },
    { "id": "died_in", "label": "Died In", "domain": ["person"], "range": ["location"] },
    { "id": "caused", "label": "Caused" },
    { "id": "enabled", "label": "Enabled" },
    { "id": "prevented", "label": "Prevented" },
    { "id": "triggered_by", "label": "Triggered By" },
    { "id": "contains", "label": "Contains" },
    { "id": "instance_of", "label": "Instance Of", "range": ["concept"] },
    { "id": "subtype_of", "label": "Subtype Of", "domain": ["concept"], "range": ["concept"] },
    { "id": "custom", "label": "Custom", "open": true }
  ]
}
