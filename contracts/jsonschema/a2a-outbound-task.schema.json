{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zbot.local/contracts/a2a-outbound-task.schema.json",
  "title": "z-Bot durable outbound A2A task payloads",
  "description": "Strict payloads for the immutable dispatch-to-poll durable handoff. Credentials and URLs are resolved from the trusted peer store and are never present here.",
  "x-spec": "docs/specs/a2a-federation-discovery/spec.md",
  "oneOf": [
    { "$ref": "#/$defs/dispatch" },
    { "$ref": "#/$defs/poll" }
  ],
  "$defs": {
    "canonicalUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 36
    },
    "peerId": {
      "type": "string",
      "pattern": "^zbot-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 41
    },
    "executionId": {
      "type": "string",
      "pattern": "^exec-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 41
    },
    "sessionId": {
      "type": "string",
      "pattern": "^sess-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 41
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 40
    },
    "workId": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "maxLength": 41
    },
    "common": {
      "type": "object",
      "required": [
        "version",
        "peer_id",
        "content",
        "source_session_id",
        "source_execution_id",
        "client_message_id"
      ],
      "properties": {
        "version": { "const": 1 },
        "peer_id": { "$ref": "#/$defs/peerId" },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "x-maxUtf8Bytes": 4000
        },
        "source_session_id": { "$ref": "#/$defs/sessionId" },
        "source_execution_id": { "$ref": "#/$defs/executionId" },
        "client_message_id": { "$ref": "#/$defs/messageId" }
      }
    },
    "dispatch": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version",
            "peer_id",
            "content",
            "source_session_id",
            "source_execution_id",
            "client_message_id"
          ],
          "properties": {
            "kind": { "const": "dispatch" },
            "version": { "const": 1 },
            "peer_id": { "$ref": "#/$defs/peerId" },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "x-maxUtf8Bytes": 4000
            },
            "source_session_id": { "$ref": "#/$defs/sessionId" },
            "source_execution_id": { "$ref": "#/$defs/executionId" },
            "client_message_id": { "$ref": "#/$defs/messageId" }
          }
        }
      ]
    },
    "poll": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "version",
            "peer_id",
            "content",
            "source_session_id",
            "source_execution_id",
            "client_message_id",
            "dispatch_work_id",
            "remote_task_id"
          ],
          "properties": {
            "kind": { "const": "poll" },
            "version": { "const": 1 },
            "peer_id": { "$ref": "#/$defs/peerId" },
            "content": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000,
              "x-maxUtf8Bytes": 4000
            },
            "source_session_id": { "$ref": "#/$defs/sessionId" },
            "source_execution_id": { "$ref": "#/$defs/executionId" },
            "client_message_id": { "$ref": "#/$defs/messageId" },
            "dispatch_work_id": { "$ref": "#/$defs/workId" },
            "remote_task_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    }
  },
  "x-maxSerializedUtf8Bytes": 65536
}
